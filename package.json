{
  "name": "@lakehouse/template-opensource",
  "version": "0.0.0",
  "private": true,
  "description": "Public open-source project template (LakeHouse brand; see .lakehouse/org.json)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "readme:gen": "node scripts/readme-gen.mjs",
    "readme:check": "node scripts/readme-gen.mjs --check",
    "citation:gen": "node scripts/citation-gen.mjs",
    "citation:check": "node scripts/citation-gen.mjs --check",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:remote": "node scripts/check-wrong-remote.mjs",
    "check:tier": "node scripts/check-tier.mjs",
    "check:runners": "node scripts/check-no-self-hosted.mjs",
    "check:org-slug": "node scripts/check-no-hardcoded-org.mjs",
    "check:pins": "node scripts/check-action-pins.mjs",
    "check:org": "node scripts/check-org-domain.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:dco": "node scripts/check-dco.mjs",
    "check:gitleaks": "node scripts/run-gitleaks.mjs",
    "check:all": "npm run check:org && npm run check:remote && npm run check:tier && npm run check:runners && npm run check:org-slug && npm run check:pins && npm run readme:check && npm run citation:check && npm run check:gitleaks"
  },
  "license": "UNLICENSED"
}
