{
  "name": "@lakehouse/template-widget",
  "version": "0.0.0",
  "description": "Standalone LakeHouse Studio widget template (agent-friendly; see .lakehouse/org.json)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    ".lakehouse",
    "apps/site",
    "dist",
    "docs",
    "overlays",
    "scripts",
    "src",
    "widget.json",
    "widget.schema.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CITATION.cff",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build-widget.mjs",
    "preview": "npm run build && node scripts/preview-server.mjs",
    "site:serve": "npm run build && node scripts/preview-server.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "readme:gen": "node scripts/readme-gen.mjs",
    "readme:check": "node scripts/readme-gen.mjs --check",
    "citation:gen": "node scripts/citation-gen.mjs",
    "citation:check": "node scripts/citation-gen.mjs --check",
    "hooks:install": "node scripts/install-hooks.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "changeset:tag": "node scripts/release-tag.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:validate": "node scripts/check-release-files.mjs",
    "check:discoverability": "node scripts/check-discoverability.mjs",
    "check:widget": "node scripts/check-widget.mjs",
    "check:hardcoded-values": "node scripts/check-hardcoded-values.mjs",
    "check:design-contract": "node scripts/check-design-contract.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "site:build": "npm ci --prefix site && npm run build --prefix site",
    "check:remote": "node scripts/check-wrong-remote.mjs",
    "check:tier": "node scripts/check-tier.mjs",
    "check:runners": "node scripts/check-no-self-hosted.mjs",
    "check:merge-group": "node scripts/check-merge-group.mjs",
    "check:org-slug": "node scripts/check-no-hardcoded-org.mjs",
    "check:pins": "node scripts/check-action-pins.mjs",
    "check:org": "node scripts/check-org-domain.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:dco": "node scripts/check-dco.mjs",
    "check:gitleaks": "node scripts/run-gitleaks.mjs",
    "check:all": "npm run check:org && npm run check:remote && npm run check:tier && npm run check:runners && npm run check:merge-group && npm run check:org-slug && npm run check:pins && npm run readme:check && npm run citation:check && npm run release:validate && npm run check:discoverability && npm run check:widget && npm run check:design-contract && npm run check:hardcoded-values && npm run check:copy && npm run build && npm test && npm run check:gitleaks"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@lakehouse/design-contract": "file:./stubs/design-contract",
    "@lakehouse/widget-sdk": "file:./stubs/widget-sdk"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.29.5",
    "@changesets/get-github-info": "^0.6.0",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
